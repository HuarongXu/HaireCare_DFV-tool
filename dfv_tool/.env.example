# Databricks SKU description lookup (optional).
# Copy this file to `dfv_tool/.env` and fill in real values on each machine.
# The real .env is gitignored and must NEVER be committed.
# If these are left blank the tool still runs; it just skips description enrichment.

DATABRICKS_HOST=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
